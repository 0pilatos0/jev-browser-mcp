{
  "name": "jev-browser-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an LLM drive a browser quickly and cheaply: Jev decides each step, code executes it.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "jev-browser-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "tsx scripts/inspect-snapshot.ts",
    "smoke": "tsx scripts/smoke.ts",
    "e2e": "tsx scripts/e2e.ts",
    "run": "tsx scripts/run.ts",
    "challenges": "tsx scripts/challenges.ts",
    "mcp-check": "tsx scripts/mcp-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
